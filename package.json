{
	"name": "time2log-user-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "bun run lint && bun run test",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --config vitest.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test": "bun run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.21.0",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.24.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/postcss": "^4.3.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.1.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"happy-dom": "^20.10.6",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.7.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.110.2",
		"d3": "^7.9.0",
		"layerchart": "^2.0.1",
		"rrule": "^2.8.1"
	},
	"patchedDependencies": {
		"layerchart@1.0.13": "patches/layerchart@1.0.13.patch"
	}
}
