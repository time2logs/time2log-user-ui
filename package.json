{
	"name": "time2log-user-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "bun run lint && bun run test",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --config vitest.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test": "bun run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.1",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.17.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.0",
		"@types/cookie": "^1.0.0",
		"@types/node": "^25.9.2",
		"autoprefixer": "^10.5.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"cookie": "^1.1.1",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.18.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.9.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.10",
		"svelte-check": "^4.4.8",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.106.2",
		"csstype": "^3.2.3",
		"d3": "^7.9.0",
		"flowbite-svelte": "^1.33.1",
		"layerchart": "^1.0.13",
		"lucide-svelte": "^1.0.1",
		"rrule": "^2.8.1"
	}
}
